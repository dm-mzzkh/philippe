# Copy to .env and fill in. Loaded automatically by `philippe` / `uv run philippe`.
# Real environment variables always override values from this file.

# Telegram bot token from @BotFather (required for `philippe run`)
PHILIPPE_BOT_TOKEN=123456:ABC-your-token-here

# Postgres DSN. Required for forms that write to / read from the DB
# (task.yaml, log.yaml, today.yaml). Matches db/docker-compose.yml. Without it,
# records are only logged and DB-backed forms refuse to start.
DATABASE_URL=postgresql://bot:bot@localhost:5432/bot_dev

# Optional whitelist: comma-separated Telegram user ids allowed to use the bot.
# Find yours via @userinfobot. Unset → the bot is open to everyone.
# PHILIPPE_ALLOWED_IDS=111111111,222222222

# Prod stack only (root compose.yml): the address pgweb binds to. Keep it off
# the public internet — set it to the host's Tailscale IP. Unset → 127.0.0.1.
# (Local dev with db/docker-compose.yml ignores this; it publishes pgweb on :8081.)
# PGWEB_BIND=100.x.y.z
