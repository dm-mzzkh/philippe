# Copy to .env and fill in. Loaded automatically by `philippe` / `uv run philippe`.
# Real environment variables always override values from this file.

# Telegram bot token from @BotFather (required for `philippe run`)
PHILIPPE_BOT_TOKEN=123456:ABC-your-token-here

# Postgres DSN. Required for forms that write to / read from the DB
# (task.yaml, log.yaml). Matches db/docker-compose.yml. Without it, records are
# only logged and DB-backed forms refuse to start.
DATABASE_URL=postgresql://bot:bot@localhost:5432/bot_dev
